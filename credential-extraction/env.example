# Kohler Anthem secrets + harness config
#
# Canonical location: /Volumes/ring/env/kohler.env
#                     (symlinked into repo as .env via `make secrets-link`)
#
# Initial setup:
#   make secrets-init   # copies this file → /Volumes/ring/env/kohler.env
#   make secrets-link   # symlinks .env → /Volumes/ring/env/kohler.env
#   $EDITOR /Volumes/ring/env/kohler.env  # fill in the YOUR_VALUE_HERE blanks
#   make secrets-check  # verifies required keys are populated
#
# Format is shell + Make compatible: `export KEY=value`. Quotes optional for
# bare values; `$VARS` and `~` are expanded by the harness loader.

# ============================================================================
# REQUIRED BY HARNESS (must be filled in before `make harness`)
# ============================================================================

# Your Kohler Konnect account credentials. Used during sign-in inside the
# emulator (manually for the first capture, automatically after recording the
# UI flow in KONNECT_SIGNIN_STEPS).
export KOHLER_USERNAME=YOUR_VALUE_HERE
export KOHLER_PASSWORD=YOUR_VALUE_HERE

# ============================================================================
# REQUIRED BY THE LIBRARY (consumed by `kohler-anthem` proper, not the harness)
# ============================================================================
# These were extracted from the APK during earlier credential-extraction work
# and rarely change. Update if Kohler rotates them.

export KOHLER_CLIENT_ID=8caf9530-1d13-48e6-867c-0f082878debc
export KOHLER_API_RESOURCE=https://konnectkohler.onmicrosoft.com/api-mob/access
export KOHLER_APIM_KEY=YOUR_VALUE_HERE        # capture via `make emulator-apim-capture`
export KOHLER_IOT_HUB_HOST=prd-hub.azure-devices.net

# Azure AD B2C URLs + policy names (from APK MSAL config; corrected via the
# 2026-05-10 spike — the canonical form uses /tfp/).
export KOHLER_B2C_AUTHORITY_BASE=https://konnectkohler.b2clogin.com/tfp/konnectkohler.onmicrosoft.com
export KOHLER_B2C_POLICY_SIGNIN=B2C_1A_signin
export KOHLER_B2C_POLICY_ROPC=B2C_1_ROPC_Auth

# Mobile app's MSAL redirect URI. Note the literal `%3D` at the end (must be
# sent as `%253D` in URL-encoded query strings).
export KOHLER_REDIRECT_URI=msauth://com.kohler.hermoth/2DuDM2vGmcL4bKPn2xKzKpsy68k%3D

# Android package id for the Konnect app.
export KOHLER_ANDROID_PACKAGE=com.kohler.hermoth

# ============================================================================
# PER-USER VALUES (obtained from device discovery API after first auth)
# ============================================================================

export KOHLER_DEVICE_ID=YOUR_VALUE_HERE
export KOHLER_TENANT_ID=YOUR_VALUE_HERE
export KOHLER_IOT_DEVICE_ID=YOUR_VALUE_HERE
# SharedAccessKey is dynamic — leave empty
export KOHLER_IOT_SHARED_ACCESS_KEY=

# ============================================================================
# APIM mTLS CLIENT CERT (from res/raw/app_certificate.p12 in the Konnect APK)
# ============================================================================
# Kohler's APIM gateway at *.kohlerkonnect-apim.azure-api.net REQUIRES mutual
# TLS with this client cert. Without it, the harness gets 403 "Invalid client
# certificate" on every request and Konnect's sign-in flow refuses to advance.
#
# The PKCS12 password was captured 2026-05-10 via Frida hooks on KeyStore.load
# (see scripts/capture_pfx_password.py). If Kohler rotates the cert in a future
# APK build, re-run `make capture-pfx-password` to recover the new value.
#
# The cert+key PEM is generated from the .p12 by `make extract-client-cert`:
#   openssl pkcs12 -in app_certificate.p12 -password pass:$PASSWORD \
#     -nodes -out <pem> -provider legacy -provider default
# (the .p12 uses RC2-40-CBC, requires OpenSSL legacy provider)

export KOHLER_APIM_CLIENT_CERT_PASSWORD=d6jaqQ1nJxFAuXs
export KOHLER_APIM_CLIENT_CERT_PEM=$HOME/Library/Caches/kohler-anthem/client-certs/app_certificate.pem

# APIM subscription key used by Konnect for the /token/* endpoint family.
# Different from the legacy KOHLER_APIM_KEY (which is for /devices/* etc).
export KOHLER_APIM_TOKEN_KEY=ca2f50cbc01845e9af356f866b16c9f1

# Service-account identity (server-side ROPC) — the access_token returned by
# GET /token/api/v1/token/ identifies as this user. The library never sees
# the password; mTLS to APIM IS the credential.
export KOHLER_APIM_SERVICE_ACCOUNT=admin.user@kohler.com
export KOHLER_APIM_SERVICE_ACCOUNT_OID=c143833c-88ff-48bc-9e12-04d65aa3ee59

# B2C tenant the service account lives in (different from the customer's
# tenant — see KOHLER_TENANT_ID below for the customer one).
export KOHLER_B2C_SERVICE_TENANT_ID=55ed507b-cce3-4176-a402-7fb9a456bbd8

# API audience (`aud` claim in the JWT). Use this when validating tokens.
export KOHLER_B2C_API_AUDIENCE=f5d87f3d-bdeb-4933-ab70-ef56cc343744

# ============================================================================
# HARNESS PATHS
# ============================================================================
# Persistent binary cache for the harness (mitmproxy CA, capture flows,
# apk-update staging, etc.). Lives outside /Volumes/ring because that volume
# is sized for secrets, not multi-hundred-MB APK bundles. The Konnect APK
# itself lives in credential-extraction/konnect-apk/ (git-LFS tracked), not
# here.
export KOHLER_HARNESS_CACHE=$HOME/Library/Caches/kohler-anthem
